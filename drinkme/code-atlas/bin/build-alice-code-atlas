#!/usr/bin/env bash
# Generate Alice source-truth code-atlas artifacts under a caller-provided output directory.

set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: build-alice-code-atlas --repo-root PATH --output-dir PATH [--format both|mermaid|dot]
EOF
}

fail() {
  printf 'error: %s\n' "$*" >&2
  exit 1
}

repo_root=""
output_dir=""
format="both"

while [[ "$#" -gt 0 ]]; do
  case "$1" in
    --repo-root)
      [[ "$#" -ge 2 ]] || fail "--repo-root requires a path"
      repo_root="$2"
      shift 2
      ;;
    --output-dir)
      [[ "$#" -ge 2 ]] || fail "--output-dir requires a path"
      output_dir="$2"
      shift 2
      ;;
    --format)
      [[ "$#" -ge 2 ]] || fail "--format requires mermaid, dot, or both"
      format="$2"
      shift 2
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      fail "unsupported argument: $1"
      ;;
  esac
done

[[ -n "${repo_root}" ]] || fail "missing --repo-root"
[[ -n "${output_dir}" ]] || fail "missing --output-dir"

if [[ ! -d "${repo_root}" ]]; then
  fail "repo root not found or not a directory: ${repo_root}"
fi

repo_root="$(cd "${repo_root}" && pwd)"
[[ -f "${repo_root}/pom.xml" ]] || fail "repository pom.xml not found under repo root: ${repo_root}"

case "${format}" in
  both|mermaid|dot) ;;
  *) fail "unsupported format '${format}'; expected Mermaid, DOT, or both" ;;
esac

if [[ -e "${output_dir}" && ! -d "${output_dir}" ]]; then
  fail "output path exists but is not a directory: ${output_dir}"
fi
mkdir -p "${output_dir}"
output_dir="$(cd "${output_dir}" && pwd)"

rel() {
  local path="$1"
  path="${path#${repo_root}/}"
  printf '%s\n' "${path}"
}

line_for() {
  local file="$1"
  local pattern="$2"
  local line
  line="$(grep -n -F "${pattern}" "${repo_root}/${file}" | head -1 | cut -d: -f1 || true)"
  if [[ -n "${line}" ]]; then
    printf '%s:%s' "${file}" "${line}"
  else
    printf '%s' "${file}"
  fi
}

extract_first_reactor_modules() {
  awk '
    /<modules>/ {
      in_modules = 1
      next
    }
    /<\/modules>/ {
      if (in_modules) {
        exit
      }
    }
    in_modules && /<module>/ {
      line = $0
      sub(/^.*<module>/, "", line)
      sub(/<\/module>.*$/, "", line)
      print line
    }
  ' "${repo_root}/pom.xml"
}

java_scan_roots() {
  for root in core alice-ide netbeans installer external core-nonfree; do
    [[ -d "${repo_root}/${root}" ]] && printf '%s\0' "${repo_root}/${root}"
  done
}

largest_java_files() {
  local roots=()
  while IFS= read -r -d '' root; do
    roots+=("${root}")
  done < <(java_scan_roots)

  [[ "${#roots[@]}" -gt 0 ]] || return 0
  find "${roots[@]}" \
    -path '*/src/*/java/*' \
    -name '*.java' \
    -type f \
    -not -path '*/target/*' \
    -print0 2>/dev/null \
    | xargs -0 -r -n 100000 wc -l \
    | awk -v root="${repo_root}/" '$2 != "total" {
        path = $2
        sub(root, "", path)
        print $1 "\t" path
      }' \
    | sort -nr \
    | sed -n '1,25p'
}

module_java_loc_rows() {
  for module in core/* alice-ide netbeans installer external/* core-nonfree/*; do
    [[ -d "${repo_root}/${module}/src" ]] || continue
    local loc
    loc="$(
      find "${repo_root}/${module}/src" \
        -name '*.java' \
        -type f \
        -not -path '*/target/*' \
        -print0 2>/dev/null \
        | xargs -0 -r -n 100000 wc -l \
        | awk '$2 != "total" {sum += $1} END {print sum + 0}'
    )"
    printf '%s\t%s\n' "${loc}" "${module}"
  done | sort -nr
}

